.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-title {
  padding: 24rpx 30rpx 16rpx;
  font-size: 24rpx;
  color: #999;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.menu-label {
  font-size: 30rpx;
  color: #333;
}

.menu-label.danger {
  color: #ff4d4f;
  text-align: center;
}

.menu-value {
  font-size: 28rpx;
  color: #999;
}

.menu-value.active {
  color: #07c160;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.set-password-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  border-bottom: 1rpx solid #eee;
}

.modal-body {
  padding: 40rpx 30rpx;
}

.password-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.error-msg {
  display: block;
  color: #ff4d4f;
  font-size: 24rpx;
  text-align: center;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #eee;
}

.btn-modal {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 30rpx;
  border: none;
  background-color: #fff;
  border-radius: 0;
}

.btn-modal.primary {
  color: #07c160;
  border-left: 1rpx solid #eee;
}

.manage-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.manage-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  max-height: 80%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.manage-content .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.manage-list {
  flex: 1;
  max-height: 600rpx;
  overflow-y: auto;
}

.manage-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.manage-item-name {
  font-size: 30rpx;
  color: #333;
}

.style-info {
  flex: 1;
}

.style-prompt {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-item-actions {
  display: flex;
  gap: 20rpx;
}

.action-edit {
  font-size: 26rpx;
  color: #07c160;
}

.action-delete {
  font-size: 26rpx;
  color: #ff4d4f;
}

.action-delete.disabled {
  color: #ccc;
}

.modal-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
}

.btn-add {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.prompt-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}