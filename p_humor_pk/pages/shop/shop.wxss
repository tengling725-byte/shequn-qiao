.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.goods-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
}

.goods-img {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.goods-icon {
  font-size: 60rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.buy-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  padding: 15rpx 40rpx;
  border-radius: 30rpx;
}

.buy-btn text {
  font-size: 26rpx;
  color: #fff;
}

.back-btn {
  margin-top: 60rpx;
  text-align: center;
  padding: 30rpx;
}

.back-btn text {
  font-size: 28rpx;
  color: #999;
}