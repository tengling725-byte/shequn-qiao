.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 0 20rpx rgba(255, 107, 107, 0.8);
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  color: #aaa;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 100rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
  min-width: 160rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.start-btn {
  width: 400rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.4);
}

.start-btn text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.start-btn:active {
  transform: scale(0.95);
}

.tips-section {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tips-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.shop-icon {
  position: fixed;
  right: 30rpx;
  bottom: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-icon text {
  font-size: 40rpx;
}

.reset-btn {
  position: fixed;
  left: 30rpx;
  bottom: 30rpx;
  padding: 15rpx 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
}

.reset-btn text {
  font-size: 24rpx;
  color: #999;
}