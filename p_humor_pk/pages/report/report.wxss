.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.content {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.report-text {
  font-size: 28rpx;
  color: #ddd;
  line-height: 1.8;
  white-space: pre-wrap;
}

.footer {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.copy-btn, .share-btn, .back-btn {
  padding: 30rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
}

.copy-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
}

.share-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  color: #fff;
}

.back-btn {
  background: rgba(255, 255, 255, 0.05);
  color: #999;
}