<view class="container">
  <view class="header">
    <text class="title">🎭 幽默分析报告</text>
  </view>
  
  <view class="content">
    <text class="report-text">{{report}}</text>
  </view>
  
  <view class="footer">
    <view class="copy-btn" bindtap="copyReport">
      <text>📋 复制报告</text>
    </view>
    <view class="share-btn" bindtap="shareReport">
      <text>📤 分享给朋友</text>
    </view>
    <view class="back-btn" bindtap="goBack">
      <text>🏠 返回首页</text>
    </view>
  </view>
</view>