.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.result-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rating {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.rating.S { background: linear-gradient(135deg, #ffd700, #ff8c00); }
.rating.A { background: linear-gradient(135deg, #4caf50, #8bc34a); }
.rating.B { background: linear-gradient(135deg, #2196f3, #03a9f4); }
.rating.C { background: linear-gradient(135deg, #ff9800, #ffc107); }
.rating.D { background: linear-gradient(135deg, #9e9e9e, #bdbdbd); }

.rating-text {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
}

.score {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.score-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.score-label {
  font-size: 28rpx;
  color: #999;
}

.explos-badge {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin-bottom: 20rpx;
}

.explos-badge text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.new-record {
  background: linear-gradient(135deg, #ffd700, #ff8c00);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin-bottom: 30rpx;
}

.new-record text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.stats {
  width: 100%;
  margin-bottom: 30rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-label {
  font-size: 28rpx;
  color: #999;
}

.stat-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.rating-desc {
  text-align: center;
}

.rating-desc text {
  font-size: 28rpx;
  color: #ccc;
}

.buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  margin-top: 40rpx;
}

.btn-primary, .btn-ai, .btn-tip, .btn-shop, .btn-home {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
}

.btn-primary text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.btn-ai {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.btn-ai text {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.btn-tip {
  background: rgba(255, 215, 0, 0.2);
  border: 2rpx solid rgba(255, 215, 0, 0.5);
}

.btn-tip text {
  font-size: 28rpx;
  color: #ffd700;
}

.btn-skin {
  background: rgba(255, 105, 180, 0.2);
  border: 2rpx solid rgba(255, 105, 180, 0.5);
}

.btn-skin text {
  font-size: 28rpx;
  color: #ff69b4;
}

.btn-shop {
  background: rgba(255, 255, 255, 0.1);
}

.btn-shop text {
  font-size: 28rpx;
  color: #fff;
}

.btn-home {
  background: rgba(255, 255, 255, 0.05);
}

.btn-home text {
  font-size: 28rpx;
  color: #999;
}

.btn-primary:active, .btn-ai:active, .btn-tip:active, .btn-shop:active, .btn-home:active {
  transform: scale(0.95);
}

.tip-modal, .ai-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.tip-content, .ai-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-height: 60vh;
}

.ai-content {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border: 2rpx solid rgba(102, 126, 234, 0.5);
}

.tip-title, .ai-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.ai-title {
  color: #fff;
}

.tip-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 30rpx;
}

.ai-loading {
  text-align: center;
  padding: 40rpx;
}

.ai-loading text {
  font-size: 28rpx;
  color: #667eea;
}

.ai-text {
  font-size: 28rpx;
  color: #ddd;
  line-height: 1.8;
  margin-bottom: 30rpx;
  white-space: pre-wrap;
}

.tip-close, .ai-close {
  text-align: center;
  color: #ff6b6b;
  font-size: 28rpx;
  padding: 20rpx;
}

.ai-close {
  color: #667eea;
}

.tip-arrows {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tip-arrow {
  font-size: 36rpx;
  color: #ff6b6b;
  padding: 10rpx 20rpx;
}

.tip-indicator {
  display: flex;
  gap: 10rpx;
}

.tip-indicator .dot {
  font-size: 32rpx;
  color: #ddd;
}

.tip-indicator .dot.active {
  color: #ff6b6b;
}

.skin-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.skin-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
}

.skin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.skin-list {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.skin-item {
  min-width: 150rpx;
  height: 100rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
}

.skin-item.active {
  border-color: #ff6b6b;
}

.skin-item text {
  font-size: 28rpx;
}

.skin-close {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 20rpx;
}

.revive-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.revive-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
}

.revive-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.revive-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 10rpx;
}

.revive-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
}

.revive-item {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  padding: 25rpx;
  border-radius: 50rpx;
  text-align: center;
}

.revive-item text {
  color: #fff;
  font-size: 30rpx;
}

.revive-cancel {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}