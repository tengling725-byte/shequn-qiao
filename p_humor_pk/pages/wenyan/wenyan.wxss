.container {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 2rpx solid #e0e0e0;
  background: #fff;
}

.back-btn {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
}

.title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.fav-btn {
  font-size: 40rpx;
  padding: 10rpx 20rpx;
}

.content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.card {
  background: #fff;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 40rpx;
  width: 100%;
  min-height: 400rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.item-title {
  font-size: 28rpx;
  color: #8B4513;
  display: block;
  margin-bottom: 20rpx;
}

.item-original {
  font-size: 32rpx;
  color: #333;
  text-align: left;
  line-height: 1.8;
  display: block;
  margin-bottom: 20rpx;
}

.item-note {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  padding-top: 20rpx;
  border-top: 1rpx dashed #ddd;
}

.item-tap {
  font-size: 24rpx;
  color: #aaa;
  display: block;
  margin-top: 20rpx;
}

.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-top: 2rpx solid #e0e0e0;
  background: #fff;
}

.arrow {
  font-size: 28rpx;
  color: #666;
  padding: 20rpx;
}

.indicator {
  font-size: 28rpx;
  color: #999;
}