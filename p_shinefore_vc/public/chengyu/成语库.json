  {
    "chengyu": "洗耳恭听",
    "shiyi": "洗清耳朵，恭敬地听讲。形容恭敬而认真地听人讲话。（多用于请人讲话时说的客气话）。",
    "type": "敬辞"
  },
  {
    "chengyu": "虚怀若谷",
    "shiyi": "谦虚的胸怀像山谷一样空旷深广。形容非常谦虚。",
    "type": "敬辞"
  },
  {
    "chengyu": "虚左以待",
    "shiyi": "虚，空着；左，古时以左位为尊。空着左边的位置等待客人，表示尊敬。也泛指留出位置恭候他人。",
    "type": "敬辞"
  },
  {
    "chengyu": "班门弄斧",
    "shiyi": "比喻在行家面前卖弄本领。",
    "type": "谦辞"
  },
  {
    "chengyu": "笨鸟先飞",
    "shiyi": "表示自己能力差，恐怕落后，比别人先行一步。",
    "type": "谦辞"
  },
  {
    "chengyu": "敝帚自珍",
    "shiyi": "比喻自己的东西再不好也值得珍惜。",
    "type": "谦辞"
  },
  {
    "chengyu": "不情之请",
    "shiyi": "客套话，不合情理的请求（向人求助时称自己的请求）。",
    "type": "谦辞"
  },
  {
    "chengyu": "不足挂齿",
    "shiyi": "足，值得；挂齿，放在嘴上说。事情轻微，不值得一提。",
    "type": "谦辞"
  },
  {
    "chengyu": "才疏学浅",
    "shiyi": "见识不广，学问不深。",
    "type": "谦辞"
  },
  {
    "chengyu": "德薄才疏",
    "shiyi": "薄，浅；疏，空虚。品行和才能都很差。",
    "type": "谦辞"
  },
  {
    "chengyu": "德薄能鲜",
    "shiyi": "德行浅薄，才能低下。",
    "type": "谦辞"
  },
  {
    "chengyu": "雕虫小技",
    "shiyi": "比喻微不足道的技能（多指文字技巧）。",
    "type": "谦辞"
  },
  {
    "chengyu": "绠短汲深",
    "shiyi": "绠，打水用的绳子；汲，从下往上打水。吊桶的绳子很短，却要从深井里打水。比喻能力微薄，任务重大。",
    "type": "谦辞"
  },
  {
    "chengyu": "恭敬不如从命",
    "shiyi": "与其态度谦逊有礼，不如遵从人家的意见。",
    "type": "谦辞"
  },
  {
    "chengyu": "姑妄言之",
    "shiyi": "姑且说说（对于自己不能深信不疑的事情，说给别人时常用此语以示保留）。",
    "type": "谦辞"
  },
  {
    "chengyu": "挂一漏万",
    "shiyi": "挂，列举；漏，遗漏。提到一个，漏掉上万。形容列举到的很少，遗漏掉的很多，很不完备。",
    "type": "谦辞"
  },
  {
    "chengyu": "管窥蠡测",
    "shiyi": "管，竹管；窥，从小孔或缝隙里看；蠡，瓢。从竹管里看天，用瓢来量大海。比喻眼光狭窄，见识浅陋。也作“以管窥天，以蠡测海”。",
    "type": "谦辞"
  },
  {
    "chengyu": "敬谢不敏",
    "shiyi": "敬，恭敬；谢，推辞；不敏，不聪明，没有才能。指恭敬地表示没有能力或不能接受（表示推辞做某事的客气话）。",
    "type": "谦辞"
  },
  {
    "chengyu": "聊表寸心",
    "shiyi": "聊，略微；寸心，微薄的心意。略微表示一下心意。",
    "type": "谦辞"
  },
  {
    "chengyu": "抛砖引玉",
    "shiyi": "抛出砖去，引回玉来。比喻用粗浅的、不成熟的意见或文章，引出别人高明的、成熟的意见或作品。",
    "type": "谦辞"
  },
  {
    "chengyu": "蓬荜生辉",
    "shiyi": "用以称谢别人来到自己家里或称谢别人题赠的字画送到自己家里。蓬筚重复“蓬门荜户”的简称，用蓬草、荆竹作门的草屋比喻穷苦人家。",
    "type": "谦辞"
  },
  {
    "chengyu": "区区此心",
    "shiyi": "区区，微小、微薄。形容微不足道的一点心意或想法。",
    "type": "谦辞"
  },
  {
    "chengyu": "容膝之安",
    "shiyi": "本指可以立足的安身之地，常用来谦称自己的居处狭小。",
    "type": "谦辞"
  },
  {
    "chengyu": "尸位素餐",
    "shiyi": "尸位，空占职位不做事；素餐，白吃饭。谦称自己未尽职责。",
    "type": "谦辞"
  },
  {
    "chengyu": "忝列门墙",
    "shiyi": "忝，表示辱没他人，自己有愧。表示自己愧在师门。",
    "type": "谦辞"
  },
  {
