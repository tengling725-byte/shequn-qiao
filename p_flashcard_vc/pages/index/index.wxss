.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 40rpx 30rpx;
  padding-bottom: 200rpx;
}

.header {
  text-align: center;
  padding: 60rpx 0;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.nickname {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.login-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  background-color: #07c160;
  border-radius: 44rpx;
}

.login-tip {
  display: block;
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 60rpx;
  background-color: #fff;
  border-radius: 16rpx;
  width: 280rpx;
}

.action-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.action-text {
  font-size: 28rpx;
  color: #333;
}

.list-section {
  margin-top: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.tab-header {
  display: flex;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  color: #333;
  font-weight: 600;
  border-bottom: 4rpx solid #333;
}

.tab-content {
  padding: 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.item-content {
  flex: 1;
}

.item-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.item-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.item-category {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 4rpx;
}

.item-time {
  font-size: 22rpx;
  color: #999;
}

.item-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 36rpx;
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}