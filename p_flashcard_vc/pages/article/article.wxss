.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 40rpx 30rpx;
  background-color: #fff;
}

.header-info {
  flex: 1;
}

.article-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.article-meta {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
}

.content {
  padding: 30rpx;
  background-color: #fff;
  margin-top: 20rpx;
}

.article-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
}

.media-section {
  margin-top: 30rpx;
}

.article-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.article-video {
  width: 100%;
  border-radius: 12rpx;
}

.edit-section {
  padding: 30rpx;
  background-color: #fff;
  margin-top: 20rpx;
}

.edit-title {
  width: 100%;
  height: 80rpx;
  font-size: 36rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.edit-content {
  width: 100%;
  min-height: 400rpx;
  font-size: 30rpx;
  line-height: 1.8;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-cancel, .btn-save {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666;
}

.btn-save {
  background-color: #333;
  color: #fff;
}

.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.btn-action {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
}