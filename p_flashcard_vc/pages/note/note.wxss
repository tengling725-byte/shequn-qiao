.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-left {
  margin-right: 20rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.form-section {
  padding: 30rpx;
  background-color: #fff;
}

.input-group {
  margin-bottom: 30rpx;
}

.title-input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.content-textarea {
  width: 100%;
  min-height: 300rpx;
  font-size: 30rpx;
  line-height: 1.6;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.media-section {
  margin: 30rpx 0;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.media-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.media-img, .media-video {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.audio-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.audio-text {
  font-size: 28rpx;
  color: #666;
}

.category-section {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}

.picker-trigger {
  display: flex;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
}

.action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 30rpx;
  background-color: #fff;
  margin-top: 20rpx;
}

.btn-ai, .btn-media, .btn-export {
  padding: 16rpx 30rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
  color: #333;
  border: none;
}

.btn-ai {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-media.recording {
  background-color: #ff4d4f;
  color: #fff;
}

.btn-export {
  background-color: #07c160;
  color: #fff;
}

.mask-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  z-index: 50;
}

.mask-layer.show {
  opacity: 1;
  visibility: visible;
}

.ai-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.ai-panel.show {
  transform: translateY(0);
}

.ai-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.ai-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.ai-close {
  font-size: 40rpx;
  color: #999;
}

.ai-styles {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.ai-style-item {
  padding: 16rpx 24rpx;
  text-align: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.ai-style-item.active {
  background-color: #667eea;
  color: #fff;
}

.btn-polish {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.export-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.export-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.export-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
}

.export-header {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.export-options {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.export-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.option-text {
  font-size: 24rpx;
  color: #666;
}

.export-cancel {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #333;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}