{
  "name": "JS基础(kimi)",
  "description": "适合有C基础、想用AI氛围编程的学习者",
  "category": "编程",
  "questions": [
    { "id": "js001", "type": "single", "content": "以下哪个是 JavaScript 声明常量的正确方式？", "options": [{ "id": 0, "text": "const int MAX = 100;", "isCorrect": false }, { "id": 1, "text": "const MAX = 100;", "isCorrect": true }, { "id": 2, "text": "#define MAX 100", "isCorrect": false }, { "id": 3, "text": "final int MAX = 100;", "isCorrect": false }], "explanation": "JS是动态类型，不需要int。const直接跟变量名。", "difficulty": 1 },
    { "id": "js002", "type": "single", "content": "执行以下代码后，x的类型依次是？\nlet x = 10;\nx = \"hello\";\nx = true;", "options": [{ "id": 0, "text": "number → string → boolean", "isCorrect": true }, { "id": 1, "text": "int → char[] → int", "isCorrect": false }, { "id": 2, "text": "编译错误", "isCorrect": false }, { "id": 3, "text": "number → number → number", "isCorrect": false }], "explanation": "JS是动态类型，变量类型随赋值改变。", "difficulty": 1 },
    { "id": "js003", "type": "single", "content": "JavaScript中以下哪种字符串定义是错误的？", "options": [{ "id": 0, "text": "'单引号字符串'", "isCorrect": false }, { "id": 1, "text": "\"双引号字符串\"", "isCorrect": false }, { "id": 2, "text": "`模板字符串`", "isCorrect": false }, { "id": 3, "text": "char str[] = \"C风格字符串\";", "isCorrect": true }], "explanation": "D是C语言语法，JS中没有char[]。", "difficulty": 1 },
    { "id": "js004", "type": "single", "content": "以下哪个是JavaScript创建数组的正确方式？", "options": [{ "id": 0, "text": "int arr[5] = {1, 2, 3};", "isCorrect": false }, { "id": 1, "text": "const arr = [1, 2, 3];", "isCorrect": true }, { "id": 2, "text": "int[] arr = new int[3];", "isCorrect": false }, { "id": 3, "text": "const arr = new Array(1, 2, 3);", "isCorrect": false }], "explanation": "JS数组用方括号定义。", "difficulty": 1 },
    { "id": "js005", "type": "single", "content": "const nums = [1, 2, 3, 4, 5];，如何得到所有偶数？", "options": [{ "id": 0, "text": "nums.filter(x => x % 2 === 0)", "isCorrect": true }, { "id": 1, "text": "for循环", "isCorrect": false }, { "id": 2, "text": "nums.select(x => x % 2 == 0)", "isCorrect": false }, { "id": 3, "text": "nums.where(x => x % 2 == 0)", "isCorrect": false }], "explanation": "JS数组有内置filter方法。", "difficulty": 2 },
    { "id": "js006", "type": "single", "content": "以下哪个是合法的箭头函数？", "options": [{ "id": 0, "text": "const add = (a, b) => { return a + b; }", "isCorrect": true }, { "id": 1, "text": "const add = (a, b) => return a + b;", "isCorrect": false }, { "id": 2, "text": "int add(int a, int b) { return a + b; }", "isCorrect": false }, { "id": 3, "text": "function add(a, b) => a + b", "isCorrect": false }], "explanation": "箭头函数语法：(参数) => { 函数体 }。", "difficulty": 1 },
    { "id": "js007", "type": "single", "content": "以下代码输出什么？\nconst greet = (name = \"用户\") => `你好，${name}`;\nconsole.log(greet());", "options": [{ "id": 0, "text": "你好，undefined", "isCorrect": false }, { "id": 1, "text": "你好，用户", "isCorrect": true }, { "id": 2, "text": "编译错误", "isCorrect": false }, { "id": 3, "text": "你好，null", "isCorrect": false }], "explanation": "JS支持默认参数，不传值时用默认值。", "difficulty": 1 },
    { "id": "js008", "type": "single", "content": "如何从对象const user = { name: '张三', age: 25 };中提取name？", "options": [{ "id": 0, "text": "const name = user.name;", "isCorrect": false }, { "id": 1, "text": "const { name } = user;", "isCorrect": false }, { "id": 2, "text": "char* name = user->name;", "isCorrect": false }, { "id": 3, "text": "A和B都对", "isCorrect": true }], "explanation": "A是传统写法，B是解构赋值。", "difficulty": 2 },
    { "id": "js009", "type": "single", "content": "以下代码输出什么？\nconst a = [1, 2];\nconst b = [...a, 3];\nconsole.log(b);", "options": [{ "id": 0, "text": "[1, 2, [3]]", "isCorrect": false }, { "id": 1, "text": "[1, 2, 3]", "isCorrect": true }, { "id": 2, "text": "编译错误", "isCorrect": false }, { "id": 3, "text": "[[1, 2], 3]", "isCorrect": false }], "explanation": "...是展开运算符。", "difficulty": 2 },
    { "id": "js010", "type": "single", "content": "以下哪个是JavaScript处理异步的标准现代写法？", "options": [{ "id": 0, "text": "callback(err, result)", "isCorrect": false }, { "id": 1, "text": ".then().catch()", "isCorrect": false }, { "id": 2, "text": "async/await", "isCorrect": false }, { "id": 3, "text": "都是，最推荐async/await", "isCorrect": true }], "explanation": "async/await让异步代码看起来像同步。", "difficulty": 2 },
    { "id": "js011", "type": "single", "content": "以下代码有什么问题？\nconst getData = async () => {\n  const res = fetch('/api/data');\n  return res.json();\n};", "options": [{ "id": 0, "text": "没有错误", "isCorrect": false }, { "id": 1, "text": "fetch前缺少await", "isCorrect": false }, { "id": 2, "text": "return前缺少await", "isCorrect": false }, { "id": 3, "text": "B和C都对", "isCorrect": true }], "explanation": "fetch返回Promise，必须用await等结果。", "difficulty": 3 },
    { "id": "js012", "type": "single", "content": "如何安全访问user.profile.avatar.url，避免user为null时报错？", "options": [{ "id": 0, "text": "user && user.profile && user.profile.avatar.url", "isCorrect": false }, { "id": 1, "text": "user?.profile?.avatar?.url", "isCorrect": false }, { "id": 2, "text": "try/catch", "isCorrect": false }, { "id": 3, "text": "A和B都对，但B更简洁", "isCorrect": true }], "explanation": "?.是可选链。", "difficulty": 2 },
    { "id": "js013", "type": "single", "content": "以下哪个是ES6模块的正确导入语法？", "options": [{ "id": 0, "text": "#include \"utils.h\"", "isCorrect": false }, { "id": 1, "text": "import { helper } from './utils.js';", "isCorrect": true }, { "id": 2, "text": "const helper = require('./utils');", "isCorrect": false }, { "id": 3, "text": "using utils;", "isCorrect": false }], "explanation": "ES6模块用import/export。", "difficulty": 1 },
    { "id": "js014", "type": "single", "content": "箭头函数和普通函数的关键区别是？", "options": [{ "id": 0, "text": "箭头函数不能当构造函数", "isCorrect": false }, { "id": 1, "text": "箭头函数没有自己的this，继承外层", "isCorrect": false }, { "id": 2, "text": "箭头函数不能用new", "isCorrect": false }, { "id": 3, "text": "以上都对", "isCorrect": true }], "explanation": "箭头函数this继承定义时的上下文。", "difficulty": 3 },
    { "id": "js015", "type": "single", "content": "0 == '0' 和 0 === '0' 的结果分别是？", "options": [{ "id": 0, "text": "true, true", "isCorrect": false }, { "id": 1, "text": "true, false", "isCorrect": true }, { "id": 2, "text": "false, false", "isCorrect": false }, { "id": 3, "text": "false, true", "isCorrect": false }], "explanation": "==会类型转换，===严格相等。", "difficulty": 3 },
    { "id": "js016", "type": "single", "content": "以下哪个描述正确？", "options": [{ "id": 0, "text": "null === undefined 为 true", "isCorrect": false }, { "id": 1, "text": "null == undefined 为 true", "isCorrect": true }, { "id": 2, "text": "null和undefined完全相同", "isCorrect": false }, { "id": 3, "text": "typeof null 返回 'null'", "isCorrect": false }], "explanation": "==认为null和undefined相等，typeof null返回'object'。", "difficulty": 3 },
    { "id": "js017", "type": "single", "content": "如何用reduce求数组[1, 2, 3, 4]的和？", "options": [{ "id": 0, "text": "nums.reduce((a, b) => a + b, 0)", "isCorrect": true }, { "id": 1, "text": "nums.reduce((a, b) => { a + b })", "isCorrect": false }, { "id": 2, "text": "nums.map(x => x).sum()", "isCorrect": false }, { "id": 3, "text": "for循环", "isCorrect": false }], "explanation": "reduce是数组归约方法。", "difficulty": 3 },
    { "id": "js018", "type": "single", "content": "如何并行发起两个请求，等全部完成后再处理？", "options": [{ "id": 0, "text": "await req1; await req2;", "isCorrect": false }, { "id": 1, "text": "await Promise.all([req1, req2]);", "isCorrect": true }, { "id": 2, "text": "req1.then(() => req2.then(...))", "isCorrect": false }, { "id": 3, "text": "thread_create(...)", "isCorrect": false }], "explanation": "A是串行，B是并行。", "difficulty": 3 },
    { "id": "js019", "type": "single", "content": "如何将JavaScript对象转为JSON字符串？", "options": [{ "id": 0, "text": "JSON.stringify(obj)", "isCorrect": true }, { "id": 1, "text": "obj.toString()", "isCorrect": false }, { "id": 2, "text": "serialize(obj)", "isCorrect": false }, { "id": 3, "text": "char* str = (char*)&obj;", "isCorrect": false }], "explanation": "JSON.stringify转字符串。", "difficulty": 1 },
    { "id": "js020", "type": "single", "content": "Vue3中定义响应式数据用？", "options": [{ "id": 0, "text": "const count = 0;", "isCorrect": false }, { "id": 1, "text": "const count = ref(0);", "isCorrect": true }, { "id": 2, "text": "const count = reactive(0);", "isCorrect": false }, { "id": 3, "text": "let count = 0;", "isCorrect": false }], "explanation": "ref用于基本类型，reactive用于对象。", "difficulty": 2 },
    { "id": "js021", "type": "multiple", "content": "以下哪些是JavaScript有、而C语言没有的特性？", "options": [{ "id": 0, "text": "动态类型", "isCorrect": true }, { "id": 1, "text": "函数作为一等公民", "isCorrect": true }, { "id": 2, "text": "内置字符串类型", "isCorrect": true }, { "id": 3, "text": "指针算术", "isCorrect": false }], "explanation": "D是C有而JS没有的。", "difficulty": 2 },
    { "id": "js022", "type": "multiple", "content": "以下哪些方法会改变原数组？", "options": [{ "id": 0, "text": "map()", "isCorrect": false }, { "id": 1, "text": "push()", "isCorrect": true }, { "id": 2, "text": "splice()", "isCorrect": true }, { "id": 3, "text": "filter()", "isCorrect": false }], "explanation": "map/filter返回新数组，push/splice改变原数组。", "difficulty": 3 },
    { "id": "js023", "type": "multiple", "content": "以下关于const的描述，正确的是？", "options": [{ "id": 0, "text": "const声明后不能重新赋值", "isCorrect": true }, { "id": 1, "text": "const对象不能修改属性", "isCorrect": false }, { "id": 2, "text": "const数组不能push元素", "isCorrect": false }, { "id": 3, "text": "const声明时必须初始化", "isCorrect": true }], "explanation": "const是绑定不可变，不是值不可变。", "difficulty": 3 },
    { "id": "js024", "type": "multiple", "content": "以下哪些场景需要用异步处理？", "options": [{ "id": 0, "text": "网络请求", "isCorrect": true }, { "id": 1, "text": "文件读取", "isCorrect": true }, { "id": 2, "text": "复杂数学计算", "isCorrect": false }, { "id": 3, "text": "用户点击按钮", "isCorrect": false }], "explanation": "网络/文件是I/O操作，需等待。", "difficulty": 3 },
    { "id": "js025", "type": "multiple", "content": "以下哪些是ES6+引入的语法？", "options": [{ "id": 0, "text": "let / const", "isCorrect": true }, { "id": 1, "text": "箭头函数 =>", "isCorrect": true }, { "id": 2, "text": "模板字符串 ``", "isCorrect": true }, { "id": 3, "text": "var", "isCorrect": false }], "explanation": "var是ES5就有的。", "difficulty": 1 },
    { "id": "js026", "type": "true_false", "content": "typeof [] 返回 'array'。", "options": [{ "id": 0, "text": "正确", "isCorrect": false }, { "id": 1, "text": "错误", "isCorrect": true }], "explanation": "返回'object'。", "difficulty": 2 },
    { "id": "js027", "type": "true_false", "content": "[] == false 为 true。", "options": [{ "id": 0, "text": "正确", "isCorrect": true }, { "id": 1, "text": "错误", "isCorrect": false }], "explanation": "空数组转布尔为true，但==比较时转数字为0。", "difficulty": 3 },
    { "id": "js028", "type": "true_false", "content": "箭头函数可以用作构造函数（new）。", "options": [{ "id": 0, "text": "正确", "isCorrect": false }, { "id": 1, "text": "错误", "isCorrect": true }], "explanation": "箭头函数没有prototype。", "difficulty": 2 },
    { "id": "js029", "type": "true_false", "content": "async函数总是返回Promise。", "options": [{ "id": 0, "text": "正确", "isCorrect": true }, { "id": 1, "text": "错误", "isCorrect": false }], "explanation": "即使return普通值，也会被包装为Promise。", "difficulty": 2 },
    { "id": "js030", "type": "true_false", "content": "Vue3的ref在模板中需要加.value。", "options": [{ "id": 0, "text": "正确", "isCorrect": false }, { "id": 1, "text": "错误", "isCorrect": true }], "explanation": "模板中自动解包。", "difficulty": 2 }
  ]
}