  "questions": [
    { "id": "db001", "type": "single", "content": "JS中声明「不可修改的变量」，最优选择是？", "options": [{ "id": 0, "text": "var x = 10;", "isCorrect": false }, { "id": 1, "text": "let x = 10;", "isCorrect": false }, { "id": 2, "text": "const x = 10;", "isCorrect": true }, { "id": 3, "text": "int x = 10;", "isCorrect": false }], "explanation": "const声明常量，不可修改，是块级作用域。", "difficulty": 1 },
    { "id": "db002", "type": "single", "content": "JS代码中，字符串拼接最简洁高效的是？", "options": [{ "id": 0, "text": "let msg = \"Hello\" + name;", "isCorrect": false }, { "id": 1, "text": "let msg = `Hello ${name}`;", "isCorrect": true }, { "id": 2, "text": "let msg = \"Hello\".concat(name);", "isCorrect": false }, { "id": 3, "text": "let msg = \"Hello %s\".replace(\"%s\", name);", "isCorrect": false }], "explanation": "模板字符串支持插值和换行。", "difficulty": 1 },
    { "id": "db003", "type": "single", "content": "JS中遍历数组let arr = [1,2,3]，最符合AI编程习惯的是？", "options": [{ "id": 0, "text": "for循环", "isCorrect": false }, { "id": 1, "text": "arr.forEach(item => console.log(item));", "isCorrect": true }, { "id": 2, "text": "for (let i in arr)", "isCorrect": false }, { "id": 3, "text": "while(arr.length > 0)", "isCorrect": false }], "explanation": "forEach是数组遍历的语义化方法。", "difficulty": 1 },
    { "id": "db004", "type": "single", "content": "关于JS对象的描述，错误的是？", "options": [{ "id": 0, "text": "JS对象类似C语言的结构体", "isCorrect": false }, { "id": 1, "text": "访问属性可以用obj.name或obj[\"name\"]", "isCorrect": false }, { "id": 2, "text": "JS对象属性可以动态添加/修改", "isCorrect": false }, { "id": 3, "text": "JS对象必须先定义结构体再创建实例", "isCorrect": true }], "explanation": "JS是弱类型语言，无需预定义结构。", "difficulty": 1 },
    { "id": "db005", "type": "single", "content": "JS中处理「网络请求」这类异步操作，最常用的语法是？", "options": [{ "id": 0, "text": "callback回调函数", "isCorrect": false }, { "id": 1, "text": "async/await", "isCorrect": true }, { "id": 2, "text": "Promise.then()", "isCorrect": false }, { "id": 3, "text": "setTimeout()", "isCorrect": false }], "explanation": "async/await让异步代码像同步。", "difficulty": 2 },
    { "id": "db006", "type": "single", "content": "下列代码的运行结果是？\nlet a = 10;\nlet b = \"10\";\nconsole.log(a === b);", "options": [{ "id": 0, "text": "true", "isCorrect": false }, { "id": 1, "text": "false", "isCorrect": true }, { "id": 2, "text": "1010", "isCorrect": false }, { "id": 3, "text": "20", "isCorrect": false }], "explanation": "===是严格相等，类型不同返回false。", "difficulty": 1 },
    { "id": "db007", "type": "single", "content": "JS中实现「函数参数默认值」，正确的写法是？", "options": [{ "id": 0, "text": "function add(x, y=0) { return x + y; }", "isCorrect": true }, { "id": 1, "text": "function add(x, y) { y = y || 0; }", "isCorrect": false }, { "id": 2, "text": "function add(x, y) { if(!y) y=0; }", "isCorrect": false }, { "id": 3, "text": "function add(x=0, y) { return x + y; }", "isCorrect": false }], "explanation": "ES6支持直接在参数列表定义默认值。", "difficulty": 2 },
    { "id": "db008", "type": "single", "content": "关于JSON的描述，正确的是？", "options": [{ "id": 0, "text": "JSON是JS的内置对象", "isCorrect": false }, { "id": 1, "text": "JSON字符串转JS对象用JSON.parse()", "isCorrect": false }, { "id": 2, "text": "JS对象转JSON字符串用JSON.stringify()", "isCorrect": true }, { "id": 3, "text": "JSON格式支持注释和函数", "isCorrect": false }], "explanation": "JSON.stringify是标准方法。", "difficulty": 1 },
    { "id": "db009", "type": "single", "content": "JS中本地存储「复杂数据（如对象）」，正确的方式是？", "options": [{ "id": 0, "text": "localStorage.setItem(\"user\", obj)", "isCorrect": false }, { "id": 1, "text": "localStorage.setItem(\"user\", JSON.stringify(obj))", "isCorrect": true }, { "id": 2, "text": "localStorage.setItem(\"user\", JSON.parse(obj))", "isCorrect": false }, { "id": 3, "text": "localStorage.setItem(\"user\", obj.toString())", "isCorrect": false }], "explanation": "存储对象需用JSON.stringify转字符串。", "difficulty": 2 },
    { "id": "db010", "type": "single", "content": "JS代码中，符合AI编程「模块化」思想的是？", "options": [{ "id": 0, "text": "所有代码写在一个script标签中", "isCorrect": false }, { "id": 1, "text": "用class封装相关方法和属性", "isCorrect": true }, { "id": 2, "text": "用全局变量传递数据", "isCorrect": false }, { "id": 3, "text": "所有函数直接定义在全局作用域", "isCorrect": false }], "explanation": "class是JS模块化的核心方式。", "difficulty": 1 },
    { "id": "db011", "type": "true_false", "content": "JS是弱类型语言，变量声明时无需指定数据类型。", "options": [{ "id": 0, "text": "正确", "isCorrect": true }, { "id": 1, "text": "错误", "isCorrect": false }], "explanation": "JS变量自动推导类型。", "difficulty": 1 },
    { "id": "db012", "type": "true_false", "content": "JS中的null和undefined含义完全相同，可互换使用。", "options": [{ "id": 0, "text": "正确", "isCorrect": false }, { "id": 1, "text": "错误", "isCorrect": true }], "explanation": "null是主动赋值，undefined是未定义。", "difficulty": 2 },
    { "id": "db013", "type": "true_false", "content": "JS数组的长度是固定的，不能动态添加/删除元素。", "options": [{ "id": 0, "text": "正确", "isCorrect": false }, { "id": 1, "text": "错误", "isCorrect": true }], "explanation": "JS数组是动态扩容的。", "difficulty": 1 },
    { "id": "db014", "type": "true_false", "content": "用async声明的函数，返回值一定是Promise对象。", "options": [{ "id": 0, "text": "正确", "isCorrect": true }, { "id": 1, "text": "错误", "isCorrect": false }], "explanation": "async函数返回值自动包装为Promise。", "difficulty": 2 },
    { "id": "db015", "type": "true_false", "content": "JS中的for...of循环可以遍历数组和对象。", "options": [{ "id": 0, "text": "正确", "isCorrect": false }, { "id": 1, "text": "错误", "isCorrect": true }], "explanation": "for...of是数组专用遍历，不能直接遍历对象。", "difficulty": 2 }
