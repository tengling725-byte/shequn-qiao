{
  "name": "JS基础(deepseek)",
  "description": "JavaScript基础测验",
  "category": "编程",
  "questions": [
    { "id": "ds001", "type": "single", "content": "以下哪个关键字声明的变量不能被重新赋值？", "options": [{ "id": 0, "text": "let", "isCorrect": false }, { "id": 1, "text": "var", "isCorrect": false }, { "id": 2, "text": "const", "isCorrect": true }, { "id": 3, "text": "都可以重新赋值", "isCorrect": false }], "explanation": "const声明的是常量，不能重新赋值。", "difficulty": 1 },
    { "id": "ds002", "type": "single", "content": "以下代码执行后，控制台输出什么？\nlet a = 10;\n{\n  let a = 20;\n}\nconsole.log(a);", "options": [{ "id": 0, "text": "10", "isCorrect": true }, { "id": 1, "text": "20", "isCorrect": false }, { "id": 2, "text": "undefined", "isCorrect": false }, { "id": 3, "text": "报错", "isCorrect": false }], "explanation": "let是块级作用域。", "difficulty": 1 },
    { "id": "ds003", "type": "single", "content": "以下代码执行后，控制台输出什么？\nvar b = 10;\n{\n  var b = 20;\n}\nconsole.log(b);", "options": [{ "id": 0, "text": "10", "isCorrect": false }, { "id": 1, "text": "20", "isCorrect": true }, { "id": 2, "text": "undefined", "isCorrect": false }, { "id": 3, "text": "报错", "isCorrect": false }], "explanation": "var是函数作用域。", "difficulty": 1 },
    { "id": "ds004", "type": "single", "content": "以下代码中，typeof x 的值是什么？\nlet x;", "options": [{ "id": 0, "text": "undefined", "isCorrect": true }, { "id": 1, "text": "null", "isCorrect": false }, { "id": 2, "text": "0", "isCorrect": false }, { "id": 3, "text": "object", "isCorrect": false }], "explanation": "声明了但未赋值的变量，类型是undefined。", "difficulty": 1 },
    { "id": "ds005", "type": "single", "content": "以下两种函数定义方式，哪个是正确的箭头函数写法？\nconst add1 = (a, b) => a + b;\nconst add2 = (a, b) => { a + b };", "options": [{ "id": 0, "text": "写法一正确", "isCorrect": true }, { "id": 1, "text": "写法二正确", "isCorrect": false }, { "id": 2, "text": "两个都正确", "isCorrect": false }, { "id": 3, "text": "两个都错误", "isCorrect": false }], "explanation": "写法二用了花括号但没有return。", "difficulty": 1 },
    { "id": "ds006", "type": "single", "content": "以下代码执行后，控制台输出什么？\nconst greet = name => \"Hello \" + name;\nconsole.log(greet(\"张三\"));", "options": [{ "id": 0, "text": "Hello 张三", "isCorrect": true }, { "id": 1, "text": "undefined", "isCorrect": false }, { "id": 2, "text": "报错", "isCorrect": false }, { "id": 3, "text": "name => \"Hello \" + name", "isCorrect": false }], "explanation": "箭头函数只有一个参数时可以省略括号。", "difficulty": 1 },
    { "id": "ds007", "type": "single", "content": "以下普通函数和箭头函数的this指向，说法正确的是？", "options": [{ "id": 0, "text": "普通函数的this是定义时决定的", "isCorrect": false }, { "id": 1, "text": "箭头函数的this是调用时决定的", "isCorrect": false }, { "id": 2, "text": "箭头函数的this是定义时决定的（继承外层）", "isCorrect": true }, { "id": 3, "text": "两者一样", "isCorrect": false }], "explanation": "箭头函数没有自己的this。", "difficulty": 2 },
    { "id": "ds008", "type": "single", "content": "以下代码执行后，控制台输出什么？（非严格模式下）\nfunction test() {\n  console.log(this);\n}\ntest();", "options": [{ "id": 0, "text": "undefined", "isCorrect": false }, { "id": 1, "text": "window或global", "isCorrect": true }, { "id": 2, "text": "null", "isCorrect": false }, { "id": 3, "text": "报错", "isCorrect": false }], "explanation": "非严格模式下this指向全局对象。", "difficulty": 2 },
    { "id": "ds009", "type": "single", "content": "以下map方法执行后，返回的结果是什么？\n[1, 2, 3].map(x => x * 2);", "options": [{ "id": 0, "text": "[1, 2, 3]", "isCorrect": false }, { "id": 1, "text": "[2, 4, 6]", "isCorrect": true }, { "id": 2, "text": "[2, 3, 4]", "isCorrect": false }, { "id": 3, "text": "undefined", "isCorrect": false }], "explanation": "map把数组每个元素按规则转换。", "difficulty": 1 },
    { "id": "ds010", "type": "single", "content": "以下filter方法执行后，返回的结果是什么？\n[1, 2, 3, 4, 5].filter(x => x > 3);", "options": [{ "id": 0, "text": "[1, 2, 3]", "isCorrect": false }, { "id": 1, "text": "[4, 5]", "isCorrect": true }, { "id": 2, "text": "[3, 4, 5]", "isCorrect": false }, { "id": 3, "text": "[1, 2, 3, 4, 5]", "isCorrect": false }], "explanation": "filter保留满足条件的元素。", "difficulty": 1 },
    { "id": "ds011", "type": "single", "content": "以下解构赋值后，name和age的值分别是什么？\nconst user = { name: \"张三\", age: 18 };\nconst { name, age } = user;", "options": [{ "id": 0, "text": "name=\"张三\", age=18", "isCorrect": true }, { "id": 1, "text": "name=\"user\", age=\"user\"", "isCorrect": false }, { "id": 2, "text": "name=undefined, age=undefined", "isCorrect": false }, { "id": 3, "text": "报错", "isCorrect": false }], "explanation": "对象解构根据属性名匹配。", "difficulty": 1 },
    { "id": "ds012", "type": "single", "content": "以下展开运算符执行后，newArr的值是什么？\nconst oldArr = [1, 2, 3];\nconst newArr = [...oldArr, 4];", "options": [{ "id": 0, "text": "[1, 2, 3]", "isCorrect": false }, { "id": 1, "text": "[1, 2, 3, 4]", "isCorrect": true }, { "id": 2, "text": "[[1,2,3], 4]", "isCorrect": false }, { "id": 3, "text": "[4, 1, 2, 3]", "isCorrect": false }], "explanation": "...将数组展开成独立元素。", "difficulty": 1 },
    { "id": "ds013", "type": "single", "content": "以下代码中，1 == \"1\" 和 1 === \"1\" 的结果分别是？", "options": [{ "id": 0, "text": "true, true", "isCorrect": false }, { "id": 1, "text": "true, false", "isCorrect": true }, { "id": 2, "text": "false, true", "isCorrect": false }, { "id": 3, "text": "false, false", "isCorrect": false }], "explanation": "==会进行类型转换。", "difficulty": 2 },
    { "id": "ds014", "type": "single", "content": "以下代码中，result的值是什么？\nconst isLoggedIn = true;\nconst result = isLoggedIn && \"欢迎回来\";", "options": [{ "id": 0, "text": "true", "isCorrect": false }, { "id": 1, "text": "false", "isCorrect": false }, { "id": 2, "text": "欢迎回来", "isCorrect": true }, { "id": 3, "text": "undefined", "isCorrect": false }], "explanation": "&&短路求值：左边为true时返回右边。", "difficulty": 2 },
    { "id": "ds015", "type": "single", "content": "以下代码中，city的值是什么？\nconst user = { name: \"张三\" };\nconst city = user?.address?.city ?? \"未知\";", "options": [{ "id": 0, "text": "undefined", "isCorrect": false }, { "id": 1, "text": "null", "isCorrect": false }, { "id": 2, "text": "未知", "isCorrect": true }, { "id": 3, "text": "报错", "isCorrect": false }], "explanation": "?.安全访问，??左侧为undefined返回默认值。", "difficulty": 2 },
    { "id": "ds016", "type": "single", "content": "以下async/await代码的输出顺序是？\nasync function test() {\n  console.log(1);\n  await 0;\n  console.log(2);\n}\ntest();\nconsole.log(3);", "options": [{ "id": 0, "text": "1,2,3", "isCorrect": false }, { "id": 1, "text": "1,3,2", "isCorrect": true }, { "id": 2, "text": "3,1,2", "isCorrect": false }, { "id": 3, "text": "2,1,3", "isCorrect": false }], "explanation": "await后面的代码会放入微任务队列。", "difficulty": 3 },
    { "id": "ds017", "type": "single", "content": "以下代码中，try/catch的作用是什么？\ntry {\n  const data = JSON.parse('{ 不合法 }');\n} catch (error) {\n  console.log(\"解析失败\");\n}", "options": [{ "id": 0, "text": "让代码跑得更快", "isCorrect": false }, { "id": 1, "text": "捕获并处理错误，避免程序崩溃", "isCorrect": true }, { "id": 2, "text": "自动修正非法JSON", "isCorrect": false }, { "id": 3, "text": "暂停代码执行", "isCorrect": false }], "explanation": "try/catch捕获错误。", "difficulty": 1 },
    { "id": "ds018", "type": "single", "content": "React中useState返回的数组，通过解构得到的两个值分别是？\nconst [count, setCount] = useState(0);", "options": [{ "id": 0, "text": "当前值，修改函数", "isCorrect": true }, { "id": 1, "text": "初始值，修改函数", "isCorrect": false }, { "id": 2, "text": "当前值，初始值", "isCorrect": false }, { "id": 3, "text": "修改函数，当前值", "isCorrect": false }], "explanation": "useState返回[当前值, 修改函数]。", "difficulty": 1 },
    { "id": "ds019", "type": "single", "content": "以下代码中，liArray是什么数据结构的数组？\nconst names = [\"张三\", \"李四\"];\nconst liArray = names.map(name => <li>{name}</li>);", "options": [{ "id": 0, "text": "字符串数组", "isCorrect": false }, { "id": 1, "text": "数字数组", "isCorrect": false }, { "id": 2, "text": "React元素数组", "isCorrect": true }, { "id": 3, "text": "对象数组", "isCorrect": false }], "explanation": "JSX中返回React元素数组。", "difficulty": 2 },
    { "id": "ds020", "type": "single", "content": "以下代码中，result的值是什么？\nconst numbers = [1, 2, 3, 2, 1];\nconst result = numbers.find(x => x > 2);", "options": [{ "id": 0, "text": "1", "isCorrect": false }, { "id": 1, "text": "2", "isCorrect": false }, { "id": 2, "text": "3", "isCorrect": true }, { "id": 3, "text": "[3]", "isCorrect": false }], "explanation": "find返回第一个满足条件的元素。", "difficulty": 1 }
  ]
}